function wavList = CheckAllVideosAvailable(wavList, wavType)

vList = [];
for ii = 1:length(wavList)
    if strfind(wavList{ii},'sentences')
        vList{ii} = (['video\' wavList{ii}(11:end-4) '.mp4']);
    else
        vList{ii} = (['video\' wavList{ii}(1:end-4) '.mp4']);
    end
end
isFine = [];
for i=1:length(vList)
    if ~exist(char(vList(i)), 'file')
        disp(['Video does not exist: ' char(vList(i))]);
    else
        isFine = [isFine,i];
    end
end
wavList = wavList(isFine);
